{
  "version": "7.0",
  "routing_model": {
    "SELECT_ACOMP": []
  },
  "screens": [
    {
      "id": "SELECT_ACOMP",
      "title": "Acompanhamentos",
      "terminal": true,
      "data": {
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "1", "title": "Arroz Branco", "description": "" },
            { "id": "2", "title": "Feijao Preto", "description": "" }
          ]
        },
        "min_items": { "type": "number", "__example__": 1 },
        "max_items": { "type": "number", "__example__": 2 }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Escolha seus acompanhamentos"
          },
          {
            "type": "TextBody",
            "text": "Marque de ${data.min_items} a ${data.max_items} opcoes e toque em Confirmar."
          },
          {
            "type": "CheckboxGroup",
            "name": "acompanhamentos",
            "label": "Acompanhamentos",
            "required": true,
            "min-selected-items": "${data.min_items}",
            "max-selected-items": "${data.max_items}",
            "data-source": "${data.options}"
          },
          {
            "type": "Footer",
            "label": "Confirmar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "acompanhamentos": "${form.acompanhamentos}"
              }
            }
          }
        ]
      }
    }
  ]
}
